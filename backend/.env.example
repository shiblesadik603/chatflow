# --- Server ---
NODE_ENV=development
PORT=5001

# --- Frontend origin (for CORS) ---
CLIENT_URL=http://localhost:5173

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/chatflow

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_string
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- File uploads ---
# Local disk by default (PUBLIC_URL/UPLOAD_DIR below). Set the three
# Cloudinary vars to switch storageService.js over to Cloudinary instead -
# needed for deployments with an ephemeral filesystem (e.g. Render).
PUBLIC_URL=http://localhost:5001
UPLOAD_DIR=uploads
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Security ---
# Number of reverse-proxy hops to trust for req.ip (rate limiting keys on
# this). Leave at 0 for local dev / no proxy. Set to 1 once deployed
# behind a single reverse proxy (Docker/Nginx, a cloud load balancer) -
# see app.js for why getting this wrong in either direction is a problem.
TRUST_PROXY=0
